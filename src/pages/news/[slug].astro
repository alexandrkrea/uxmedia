---
// Страница новости: /news/<slug>/
import { render, getEntries } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArticleShell from '../../components/ArticleShell.astro';
import SummaryBox from '../../components/SummaryBox.astro';
import TagList from '../../components/TagList.astro';
import Card from '../../components/Card.astro';
import Pic from '../../components/Pic.astro';
import Lightbox from '../../components/Lightbox.astro';
import Gallery from '../../components/mdx/Gallery.astro';
import Figure from '../../components/mdx/Figure.astro';
import Quote from '../../components/mdx/Quote.astro';
import Checks from '../../components/mdx/Checks.astro';
import { SITE } from '../../data/site';
import { allNews, promo as getPromo, related, autoBanner, sectionSlug } from '../../lib/news';
import Banners from '../../components/Banners.astro';
import { href, route, absUrl } from '../../lib/url';
import { dateLabel, iso, readingMinutes } from '../../lib/format';
import { graph, organization, breadcrumbs, authorOrg, publisherRef } from '../../lib/seo';

export async function getStaticPaths() {
  return (await allNews()).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;

const all = await allNews();
const defaultPromo = await getPromo();
const { Content } = await render(entry);
const tags = (await getEntries(d.tags)).map(t => ({ id: t.id, name: t.data.name }));
const rel = related(all, entry);
// баннер справа: выбранный вручную, иначе самый подходящий автоматически, иначе баннер по умолчанию
const picked = d.banner ? all.find(n => n.id === d.banner!.id && n.id !== entry.id) : undefined;
const shown = rel.map(r => r.id);
const defaultFits = !!defaultPromo && defaultPromo.id !== entry.id && !shown.includes(defaultPromo.id);
const promo = picked ?? autoBanner(all, entry, shown) ?? (defaultFits ? defaultPromo : undefined) ?? all.find(n => n.id !== entry.id && !shown.includes(n.id));
const hasGallery = (entry.body ?? '').includes('<Gallery');
const minutes = readingMinutes(entry.body ?? '');

const crumbs = [
  { name: 'главная', path: '' },
  { name: d.section, path: route.section(sectionSlug(d.section)) },
  { name: d.title },
];

// картинки: для соцсетей (1200×630) и для разметки статьи
const og = await getImage({ src: d.image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const ogImage = new URL(og.src, Astro.site).href;
const article = {
  '@type': 'NewsArticle',
  '@id': `${absUrl(route.article(entry.id))}#article`,
  headline: d.title,
  description: d.lead,
  image: [{ '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 }],
  datePublished: iso(d.date),
  dateModified: iso(d.updated ?? d.date),
  author: authorOrg(),
  publisher: publisherRef(),
  mainEntityOfPage: absUrl(route.article(entry.id)),
  inLanguage: SITE.lang,
  articleSection: d.section,
  keywords: tags.map(t => t.name).join(', '),
  isAccessibleForFree: true,
};
const ogMeta = {
  'article:published_time': iso(d.date),
  'article:modified_time': iso(d.updated ?? d.date),
  'article:section': d.section,
  'article:tag': tags.map(t => t.name),
};
---

<Base
  title={`${d.title} — ${SITE.name}`}
  description={d.lead}
  ogType="article"
  ogImage={ogImage}
  ogMeta={ogMeta}
  layoutClass="layout--article"
  section={sectionSlug(d.section)}
  jsonLd={[graph(organization(), article, breadcrumbs(crumbs))]}
>
  <ArticleShell crumbs={crumbs} h1={d.title} lead={d.lead}>
    <p slot="byline" class="byline">
      <span class="byline__info">
        <time datetime={iso(d.date)}>{dateLabel(d.date)}</time>
        <span>{minutes} мин чтения</span>
      </span>
      <span class="byline__author">Автор: <a href={href(SITE.author.path)}>{SITE.author.name}</a></span>
    </p>

    <SummaryBox slot="summary" items={d.summary} />

    <figure slot="hero" class="article__media article__media--hero bleed">
      <div class="ph"><Pic src={d.image} alt={d.title} priority /></div>
    </figure>

    <Content components={{ Gallery, Figure, Quote, Checks }} />
    <TagList tags={tags} updated={d.updated} />

    {rel.length > 0 && (
      <section slot="after" class="related-wrap" aria-label="Читайте также">
        <h2 class="related-title">Читайте также</h2>
        <div class="related">{rel.map(m => <Card news={m} kind="wide" />)}</div>
      </section>
    )}
  </ArticleShell>

  <aside class="aside" aria-label="Подборка">
    <Banners items={promo ? [promo] : []} />
  </aside>

  {hasGallery && <Lightbox slot="after" />}
</Base>
