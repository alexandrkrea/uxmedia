---
// Белая карточка-статья: крошки, подпись (автор, даты), заголовок, лид, обложка, «Коротко и по делу», содержимое.
// Используют новость, «О проекте» и итоги недели.
import Crumbs from './Crumbs.astro';

interface Props {
  crumbs: { name: string; path?: string }[];
  h1: string;
  lead: string;
}
const { crumbs, h1, lead } = Astro.props;
---

<main class="article-col" id="content">
  <article class="article">
    <div class="article__inner">
      <Crumbs items={crumbs} />
      <slot name="byline" />
      <header class="article__head">
        <h1>{h1}</h1>
        <p class="article__lead">{lead}</p>
      </header>
    </div>
    <slot name="hero" />
    {Astro.slots.has('summary') && <div class="article__summary"><slot name="summary" /></div>}
    <div class="article__body prose">
      <slot />
    </div>
  </article>
  <slot name="after" />
</main>
