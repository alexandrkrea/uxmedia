---
// Блок «Коротко и по делу»: ответ сразу под обложкой (удобно людям и нейросетям).
interface Props { items: string[]; title?: string }
const { items, title = 'Коротко и по делу' } = Astro.props;
---

<aside class="summary" aria-label={title}>
  <h2>{title}</h2>
  <ul>{items.map(t => <li>{t}</li>)}</ul>
</aside>
