---
// Хлебные крошки: путь до родителя. Текущую страницу не повторяем: её название и так в заголовке h1.
// path — адрес относительно корня сайта. Меньше двух пунктов — блок не нужен.
import { href } from '../lib/url';
import { trail } from '../lib/seo';

interface Props { items: { name: string; path?: string }[] }
const items = trail(Astro.props.items);
---

{items.length > 0 && (
  <nav class="crumbs" aria-label="Хлебные крошки">
    <ol>
      {items.map(c => <li><a href={href(c.path ?? '')}>{c.name}</a></li>)}
    </ol>
  </nav>
)}
