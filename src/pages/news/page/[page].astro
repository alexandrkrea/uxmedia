---
// Архив новостей: /news/page/2/, /news/page/3/ …  (страница 1 — это главная)
import FeedPage from '../../../layouts/FeedPage.astro';
import { feed, totalPages } from '../../../lib/news';

export async function getStaticPaths() {
  const total = totalPages(await feed());
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({ params: { page: String(i + 2) }, props: { page: i + 2 } }));
}
const { page } = Astro.props;
---

<FeedPage page={page} />
