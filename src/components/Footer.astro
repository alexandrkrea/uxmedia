---
import * as i from '../lib/icons';
import { SITE } from '../data/site';
---

<footer class="footer">
  <div class="footer__line"></div>
  <button class="to-top" id="to-top" type="button" aria-label="Наверх"><Fragment set:html={i.arrowUp} /></button>
  <div class="footer__row">
    <div class="footer__text">
      <p>{SITE.footerText}</p>
      <small>© {new Date().getFullYear()} {SITE.name}</small>
    </div>
    <button class="cookie" type="button">Настройки файлов cookie</button>
  </div>
</footer>
