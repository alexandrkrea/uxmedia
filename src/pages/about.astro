---
// О проекте: /about/. Текст, лид и «Коротко» правятся в админке («О проекте», src/content/about/index.mdx).
// Ссылки в боковом меню ведут на заголовки «Контакты», «Реклама», «Предложить новость»: не переименовывайте их.
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleShell from '../components/ArticleShell.astro';
import SummaryBox from '../components/SummaryBox.astro';
import Banners from '../components/Banners.astro';
import { SITE } from '../data/site';
import { homeBanners } from '../lib/news';
import { route, absUrl } from '../lib/url';
import { graph, organization, breadcrumbs } from '../lib/seo';

const entry = (await getEntry('about', 'index'))!;
const { Content } = await render(entry);
const { title, lead, summary } = entry.data;
const banners = await homeBanners();
const crumbs = [{ name: 'главная', path: '' }, { name: 'о проекте' }];
const about = {
  '@type': 'AboutPage',
  '@id': `${absUrl(route.about)}#about`,
  url: absUrl(route.about),
  name: title,
  description: lead,
  inLanguage: SITE.lang,
  about: { '@id': `${absUrl()}#org` },
};
---

<Base title={`${title} — ${SITE.name}`} description={lead} layoutClass="layout--article" section="novosti" jsonLd={[graph(organization(), about, breadcrumbs(crumbs))]}>
  <ArticleShell crumbs={crumbs} h1={title} lead={lead}>
    <SummaryBox slot="summary" items={summary} />
    <Content />
  </ArticleShell>

  <aside class="aside" aria-label="Подборка">
    <Banners items={banners} />
  </aside>
</Base>
