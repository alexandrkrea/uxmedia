---
// Общий каркас страницы: head (метаданные, Open Graph, JSON-LD), шапка, меню, подвал, поиск, скрипты.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { SITE } from '../data/site';
import { href, absUrl } from '../lib/url';
import cyrillicFont from '../assets/fonts/roboto-flex-cyrillic.woff2?url';
import latinFont from '../assets/fonts/roboto-flex-latin.woff2?url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string; // абсолютный адрес картинки 1200×630
  ogType?: 'website' | 'article';
  ogMeta?: Record<string, string | string[]>; // article:published_time и т.п.
  noindex?: boolean;
  jsonLd?: object[];
  layoutClass?: string;
  section?: string; // slug раздела меню (отмечается для скринридеров)
}
const { title, description = SITE.description, ogImage, ogType = 'website', ogMeta = {}, noindex = false, jsonLd = [], layoutClass, section } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = ogImage ?? absUrl('og.jpg');
const robots = !SITE.indexable || noindex;
const ld = (d: object) => JSON.stringify(d).replace(/</g, '\\u003c');
// Тема ставится до отрисовки (без вспышки): сохранённый выбор, иначе системная.
const themeScript = `document.documentElement.classList.add('js');try{var t=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=t}catch(e){}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#e6e7e8" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={href('rss.xml')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {Object.entries(ogMeta).flatMap(([k, v]) => [v].flat().map(x => <meta property={k} content={x} />))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd.map(d => <script type="application/ld+json" set:html={ld(d)} />)}
    <link rel="preload" href={cyrillicFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <a class="skip-link" href="#content">Перейти к содержимому</a>
    <div class="page">
      <Header />
      <div class:list={['layout', layoutClass]}>
        <Sidebar active={section} />
        <slot />
      </div>
      <Footer />
    </div>
    <slot name="after" />
    <SearchDialog />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
